{
  "name": "swiish",
  "version": "0.7.0-dev",
  "description": "Open‑source digital business card platform",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/MrCrin/swiish.git"
  },
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"yellow,cyan\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm run serve",
    "migrate": "cd backend && npm run migrate",
    "postinstall": "cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}